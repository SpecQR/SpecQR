{
  "name": "specqr",
  "version": "2.2.1",
  "description": "A dependency-free QR Code Model 2 generator for JavaScript.",
  "homepage": "https://github.com/SpecQR/SpecQR#readme",
  "bugs": {
    "url": "https://github.com/SpecQR/SpecQR/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpecQR/SpecQR.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./src/browser.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "import": "./src/node.js"
    }
  },
  "files": [
    "src",
    "docs",
    "examples",
    "fixtures",
    "playground",
    "tools",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "fixtures:golden": "node tools/update-golden-fixtures.js",
    "examples:node": "node examples/node-save-png.mjs",
    "examples:gs1": "node examples/gs1-qr.mjs",
    "examples:gs1-digital-link": "node examples/gs1-digital-link.mjs",
    "examples:structured-append": "node examples/structured-append.mjs",
    "examples:structured-append-merge": "node examples/structured-append-merge.mjs",
    "examples:smoke": "node tools/verify-examples.js",
    "pages:build": "node tools/build-pages.js",
    "playground": "node tools/serve-playground.js",
    "verify:decode": "node tools/verify-decode.js",
    "verify:decode:optional": "node tools/verify-decode-optional.js",
    "verify:decode:jsqr": "node tools/verify-decode-optional.js --only-jsqr --require-jsqr",
    "verify:decode:independent": "npm run verify:decode:jsqr",
    "verify:structured-append:zxing-java": "node tools/verify-structured-append-zxing-java.js",
    "verify:types": "tsc -p tests/types/tsconfig.json --noEmit",
    "verify:pack": "node tools/verify-packed-package.js",
    "verify:published": "node tools/verify-published-package.js",
    "verify:reference:nayuki": "node tools/verify-reference-nayuki.js"
  },
  "keywords": [
    "qr",
    "qrcode",
    "barcode",
    "svg",
    "png",
    "kanji",
    "shift-jis",
    "gs1",
    "eci",
    "model2"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "jsqr": "^1.4.0",
    "nayuki-qr-code-generator": "^1.8.0",
    "typescript": "^6.0.3"
  }
}
